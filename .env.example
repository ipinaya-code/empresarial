# Solo laboratorio; no copiar estas credenciales a un despliegue público.
APP_ENV=development
APP_DEBUG=false
DEMO_ROUTES_ENABLED=true
AUTO_CREATE_SCHEMA=false
POSTGRES_USER=boa_admin
POSTGRES_PASSWORD=local-lab-only
POSTGRES_DB=boa_reservas
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5455
# Opcional: DATABASE_URL prevalece sobre POSTGRES_* (escapar caracteres de contraseña en URL).
VALKEY_URL=redis://127.0.0.1:6379/0
CACHE_ENABLED=false
CACHE_TTL_SECONDS=30
READ_MODE=refactored
SECURE_LOCK_DELAY_SECONDS=0
INSECURE_DELAY_SECONDS=0.5
PROVISIONAL_TTL_MINUTES=10
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
LOG_LEVEL=INFO
# SECRET_KEY, API_KEY y RATE_LIMIT_PER_MINUTE aún NO implementan autenticación/rate limiting.
