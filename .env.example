# ============================================================
# Configuración del Prototipo de Reservas BoA
# Copiar este archivo como .env y ajustar los valores
# ============================================================

# ---------- Aplicación ----------
APP_NAME="Sistema de Reservas BoA"
APP_VERSION="2.0.0"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ---------- PostgreSQL ----------
POSTGRES_USER=boa_admin
POSTGRES_PASSWORD=boa_s3cur3_p4ss
POSTGRES_DB=boa_reservas
POSTGRES_HOST=localhost
POSTGRES_PORT=5455
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------- Valkey (Cache) ----------
VALKEY_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=600

# ---------- Seguridad ----------
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_KEY=dev-api-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------- Concurrencia (Simulación) ----------
SECURE_LOCK_DELAY_SECONDS=60
INSECURE_DELAY_SECONDS=0.5
PROVISIONAL_TTL_MINUTES=10

# ---------- Rate Limiting ----------
RATE_LIMIT_PER_MINUTE=60
